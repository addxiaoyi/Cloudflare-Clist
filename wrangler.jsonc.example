{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clist",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_TITLE": "Starx",
    "SITE_ANNOUNCEMENT": "Welcome to Starx storage service!",
    "CHUNK_SIZE_MB": "10",
    "WEBDAV_ENABLED": "false",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "changeme",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_CLIENT_SECRET": "",
    "GOOGLE_REDIRECT_URI": "",
    "ONEDRIVE_CLIENT_ID": "",
    "ONEDRIVE_CLIENT_SECRET": "",
    "ONEDRIVE_REDIRECT_URI": "",
    "CF_CLIENT_ID": "",
    "CF_CLIENT_SECRET": "",
    "CF_REDIRECT_URI": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clist"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "clist"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HD",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "mysql://root:password@localhost:3306/db"
    }
  ]
}
